# Base image: the tag is for humans, the digest is the identity (multi-platform
# index: arm64 + amd64). Refresh deliberately (the platform repository's
# scripts/build/pin-base-images.py). SUPERSEDED 2026-10-08: FROM python:3.12-slim
FROM docker.io/library/python:3.12-slim@sha256:05cda9777409a9c3ffddd94a4c476b79f0769a0b4857f0c7ed9226b6800b0d6f
WORKDIR /app

# gnupg: needed at runtime by main.py's _verify_self() (signed-manifest
# integrity self-check, see that function's docstring and this repo's
# security/ + scripts/verify-manifest.sh).
# OS packages from a dated Debian archive snapshot, not the live mirror.
# SUPERSEDED 2026-10-08: apt-get update against the live mirror (floating).
ARG APT_SNAPSHOT=20261007T000000Z
RUN printf 'APT::Snapshot "%s";\n' "${APT_SNAPSHOT}" > /etc/apt/apt.conf.d/50snapshot \
 && apt-get update -qq \
 && apt-get install -y --no-install-recommends gnupg \
 && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
# Python: install ONLY the hash-locked requirements.txt (intent: requirements.in).
# SUPERSEDED 2026-10-08: pip install --no-cache-dir -r requirements.txt (exact pins, no hashes)
RUN pip install --no-cache-dir --require-hashes --no-deps --only-binary=:all: -r requirements.txt
COPY main.py .

# Duplicated from the repo root (not COPYed from ../security etc.) because
# this image's build context has always been contact-api/ itself, not the
# repo root -- confirmed via `podman image inspect --format '{{.History}}'`
# on the existing image before changing anything. scripts/sign-manifest.sh
# copies the freshly-signed MANIFEST.sha256/.asc here automatically on every
# run, so these never drift out of sync with the repo-root originals.
COPY MANIFEST.sha256 MANIFEST.sha256.asc trusted-signing-key.pub.asc ./

EXPOSE 8002
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8002"]
