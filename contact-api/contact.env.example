# /etc/corporatetraveldc/contact.env
# Contact form API — SMTP credentials (mode 0600, never commit)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-app-password
NOTIFY_TO=reservations@csexecutiveservices.com
NOTIFY_FROM=reservations@csexecutiveservices.com
